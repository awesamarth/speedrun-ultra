    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  },
  "packageManager": "bun@1.3.14",
